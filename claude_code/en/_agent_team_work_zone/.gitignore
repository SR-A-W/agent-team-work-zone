# Upgrade staging area: filled in temporarily by the user only during an upgrade; not committed.
.upgrade/*
!.upgrade/README.md

# Teammate "started" marker: written by step 0 of every spawn/reactivate prompt; runtime state, not committed.
*_team/teammates/*/.started

# Other runtime-only files: hook logs, the idle hook's counter, the registry backup that is
# rewritten on every write (git already keeps the history), and temp files that an
# interrupted write can leave behind. Rules backups (*.rules.bak.*, *.teammate_rules.bak.*)
# stay tracked: they can hold user content.
.hook_logs/
*_team/teammates/*/.checkpoint_nudge_count
*_team/TEAMMATE_INFO.json.bak
*_team/.info.??????
*_team/.policy.??????
# /remote-collab runtime state: changes on every check, merge and push; tracking it would only create commits and conflicts.
*_team/.remote_collab_state
*/.remote_collab_state
*_team/teammates/*/remote_seen
*_team/teammates/*/digests/
*_team/teammates/*/loop_job
*_team/.remote_seen
*/.remote_seen
*_team/.remote_collab_watch.pid
*/.remote_collab_watch.pid
*_team/digests/
*/digests/
*/.rc.??????
**/.README.md.??????
# Temp files from an interrupted rewrite of VERSION or settings.conf.
/.VERSION.??????
/settings.conf.??????
